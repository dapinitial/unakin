---
import Base from '../layouts/Base.astro';
import heartSvg from '../svg/heart.svg?raw';
import brainSvg from '../svg/brain.svg?raw';

// Line-art loading state for each glass model (tools/outline-svg.mjs). Each stroke gets an
// animated gradient (violet → accent → mint) sliding along it; defs live inside the SVG so the
// url(#id) reference is local and Safari-safe.
const outline = (svg: string, id: string) => svg.replace(
  '>',
  `><defs><linearGradient id="${id}" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="600" y2="600" spreadMethod="repeat">
    <stop offset="0" stop-color="#6d4aff"/><stop offset=".45" stop-color="#bcc0ff"/><stop offset=".7" stop-color="#8bf0cf"/><stop offset="1" stop-color="#6d4aff"/>
    <animateTransform attributeName="gradientTransform" type="translate" from="0 0" to="600 600" dur="2.6s" repeatCount="indefinite"/>
  </linearGradient></defs>`,
).replace('<svg ', `<svg style="--grad:url(#${id})" `);

const services = [
  { k: 'Product design', d: 'Interfaces and product thinking — from first principle to pixel. Systems people actually want to use.' },
  { k: 'Software engineering', d: 'Full-stack builds on a lean, modern house stack. Shipped, hardened, and yours to own.' },
  { k: 'Immersive 3D · WebGL', d: 'Real-time 3D, generative visuals, and spatial experiences that run buttery in the browser.' },
  { k: 'Design systems & brand', d: 'The identity, the tokens, the components — one coherent system across everything you make.' },
];

const work = [
  { name: 'Sedulous', tag: 'Product · platform', d: 'A readiness platform for tactical athletes — training, recovery, and performance in one system.' },
  { name: 'Immersive Trail & Terrain Maps', tag: '3D · WebGL', d: 'Branded, per-trip 3D fly-throughs with guide tools — routes, sun, water, camps, points of interest.' },
  { name: 'd-tours', tag: 'Product · mobile', d: 'A location-aware experience layer — turning where you are into something worth exploring.' },
];
---
<Base path="/">
  <main>
    <!-- HERO — glass anatomical heart; intact at rest, shatters as you scroll -->
    <section class="hero container">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>Design &amp; engineering studio</p>
        <h1 class="hero-title" data-reveal>
          Not akin to<br /><span class="grad-text">anything else.</span>
        </h1>
        <p class="hero-sub" data-reveal>
          Unakin is an avant-garde design &amp; engineering studio. We design and ship
          products — interfaces, systems, and immersive 3D — with the craft of a team that
          spent two decades at <strong>Apple</strong> and <strong>Microsoft</strong>.
        </p>
        <div class="hero-cta" data-reveal>
          <a class="btn" href="#start">Start a project</a>
          <a class="ghost-btn" href="#work">See the work</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="ghost-word">HEART</span>
        <glass-model class="hero-model" model="/models/heart.glb" mode="shatter" reveal="load" hold="2400">
          <div class="outline" set:html={outline(heartSvg, 'g-heart')} />
        </glass-model>
        <div class="stat stat-h1" data-reveal><b>Award</b><span>winning product design</span></div>
        <div class="stat stat-h2" data-reveal><b>1 team</b><span>design &amp; build, same hands</span></div>
        <div class="stat stat-h3" data-reveal><b>Principal</b><span>level · and principled</span></div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="block container" id="studio">
      <p class="eyebrow" data-reveal>What we do</p>
      <h2 class="block-h" data-reveal>A studio that designs it <em>and</em> builds it.</h2>
      <div class="grid">
        {services.map((s) => (
          <article class="card" data-reveal>
            <h3>{s.k}</h3>
            <p class="muted">{s.d}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- THESIS — glass brain assembles from shards as it scrolls into view -->
    <section class="block container thesis" id="thesis">
      <div class="thesis-art" aria-hidden="true">
        <span class="ghost-word">BRAIN</span>
        <glass-model class="thesis-model" model="/models/brain.glb" mode="assemble" spread="3.2" hold="2400">
          <div class="outline" set:html={outline(brainSvg, 'g-brain')} />
        </glass-model>
        <div class="stat stat-a" data-reveal><b>20 yrs</b><span>Apple · Microsoft</span></div>
        <div class="stat stat-b" data-reveal><b>0</b><span>handoffs — one team designs &amp; ships</span></div>
        <div class="stat stat-c" data-reveal><b>60 fps</b><span>real-time 3D in the browser</span></div>
      </div>
      <div class="thesis-copy">
        <p class="eyebrow" data-reveal>The studio thesis</p>
        <h2 class="block-h" data-reveal>Heart for the craft.<br /><em>Brain</em> for the build.</h2>
        <p class="muted" data-reveal>
          Most studios split feeling from function — a design agency hands a deck to a dev shop
          and the soul leaks out in between. We're one team, so the thing you fall for in the
          mockup is the thing that ships: same hands, same taste, same obsession with the
          last 2%.
        </p>
        <p class="muted" data-reveal>
          Principal-level, and principled. No account managers, no juniors learning on your
          dime. You talk to the people doing the work.
        </p>
      </div>
    </section>

    <!-- WORK -->
    <section class="block container" id="work">
      <p class="eyebrow" data-reveal>Selected work</p>
      <h2 class="block-h" data-reveal>Things we've made unakin.</h2>
      <div class="worklist">
        {work.map((w) => (
          <article class="workrow" data-reveal>
            <div class="workmeta"><span class="mono tag">{w.tag}</span></div>
            <div class="workbody">
              <h3>{w.name}</h3>
              <p class="muted">{w.d}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- INTAKE -->
    <section class="block container narrow" id="start">
      <p class="eyebrow" data-reveal>Start a project</p>
      <h2 class="block-h" data-reveal>Tell us what you're building.</h2>
      <p class="muted intro" data-reveal>
        A sentence or a spec — either works. We'll read it, sketch an approach, and come
        back with a plan. Corporations pay the rack rate; makers, nonprofits, and fellow
        rope-teams get a fairer one. We'll figure out where you land together.
      </p>

      <form class="intake" id="intake" data-reveal>
        <div class="two">
          <label>Your name<input name="name" required placeholder="Jane Maker" /></label>
          <label>Email<input name="email" type="email" required placeholder="jane@company.com" /></label>
        </div>
        <label><span>Company <span class="muted">(optional)</span></span><input name="company" placeholder="Company or project" /></label>
        <label>What are you building?<textarea name="project" required rows="5" placeholder="The idea, the problem, the dream. As much or as little as you've got."></textarea></label>
        <div class="two">
          <label>Budget
            <select name="budget">
              <option value="">Prefer to discuss</option>
              <option>Just exploring</option>
              <option>Under $10k</option>
              <option>$10k–$30k</option>
              <option>$30k+</option>
              <option>Barter / trade</option>
            </select>
          </label>
          <label><span>Timeline <span class="muted">(optional)</span></span><input name="timeline" placeholder="e.g. this quarter" /></label>
        </div>
        <!-- honeypot: bots fill it, humans never see it -->
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="intake-actions">
          <button class="btn" type="submit">Send it →</button>
          <span class="intake-msg" role="status"></span>
        </div>
      </form>

      <div class="intake-done" hidden>
        <h3 class="grad-text">Got it. 🤝</h3>
        <p class="muted">We'll be in touch soon — from <strong>hello@unakin.com</strong>. Talk shortly.</p>
      </div>
    </section>
  </main>

  <style>
    .hero {
      position: relative; padding: clamp(3rem, 9vh, 6rem) 0 clamp(3rem, 8vh, 6rem); min-height: calc(100vh - 4.5rem);
      display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); align-items: center; gap: 2rem;
    }
    .hero-copy { position: relative; z-index: 2; }
    .hero-title { font-family: var(--display); text-transform: uppercase; font-weight: 400; font-size: clamp(2.4rem, 6.4vw, 5.6rem); line-height: 0.82; letter-spacing: 0.07em; margin: 1.2rem 0 0; }
    .hero-sub { max-width: 44ch; margin-top: 1.6rem; font-size: clamp(1.05rem, 2vw, 1.25rem); color: var(--muted); }
    .hero-sub strong { color: var(--text); font-weight: 600; }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2.2rem; }
    .hero-art { position: relative; aspect-ratio: 1; max-height: 78vh; display: grid; place-items: center; }
    .hero-model { position: absolute; inset: -22%; }
    /* Ghosted background word (editorial/techno, from the Arkkhe refs). */
    .ghost-word {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      font-family: var(--display); text-transform: uppercase; font-size: clamp(5rem, 15vw, 15rem); letter-spacing: 0.08em;
      color: transparent; -webkit-text-stroke: 1px rgba(188, 192, 255, 0.16); user-select: none; pointer-events: none; white-space: nowrap;
    }
    @media (max-width: 860px) {
      .hero { grid-template-columns: 1fr; min-height: 0; padding-top: 2rem; }
      .hero-art { order: -1; aspect-ratio: auto; height: 46vh; max-height: 22rem; margin-inline: -1.25rem; }
      .hero-model { inset: 0; }
      .ghost-word { font-size: clamp(3.5rem, 22vw, 7rem); }
    }

    /* SVG line-art loading state: strokes draw on (gradient sliding through them) once the
       model is in view, then dissolve when the glass flashes in. Sized to sit exactly where
       the 3D model renders (the canvas host is inset -22% / -24%). */
    .outline { position: absolute; inset: 12.5%; opacity: 1; transition: opacity 1.2s ease 0.15s; --step: 7ms; }
    .thesis-model .outline { --step: 4.5ms; }
    /* The SVG is injected via set:html, so its nodes have no Astro scope attribute → :global. */
    .outline :global(svg) { width: 100%; height: 100%; display: block; overflow: visible; }
    .outline :global(path) {
      stroke: var(--grad); stroke-width: 1.5; vector-effect: non-scaling-stroke;
      stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0.9;
    }
    glass-model[data-view] .outline :global(path) { animation: draw 1.3s cubic-bezier(0.3, 0.8, 0.3, 1) forwards; animation-delay: calc(var(--i) * var(--step)); }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    glass-model[data-loaded] .outline { opacity: 0; }
    glass-model[data-error] .outline { opacity: 0.9; } /* no WebGL / load failed → the drawing IS the art */
    @media (prefers-reduced-motion: reduce) { .outline :global(path) { stroke-dashoffset: 0; animation: none !important; } }

    /* Heart stat cards (the .stat base styles live with the thesis block below). */
    .stat-h1 { right: -4%; top: 12%; }
    .stat-h2 { left: -7%; top: 50%; max-width: 12rem; }
    .stat-h3 { right: -2%; bottom: 9%; max-width: 13rem; }
    @media (max-width: 860px) { .stat-h1 { right: 0; } .stat-h2 { left: 0; } .stat-h3 { right: 0; bottom: 4%; } }

    /* Thesis: brain left, copy right, floating stat cards over the model. */
    .thesis { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; align-items: center; }
    .thesis-art { position: relative; aspect-ratio: 1; max-height: 72vh; }
    .thesis-model { position: absolute; inset: -24%; }
    .thesis-copy .block-h { margin-bottom: 1.4rem; }
    .thesis-copy p.muted { max-width: 44ch; margin-bottom: 1rem; font-size: 1.02rem; }
    .stat {
      position: absolute; z-index: 2; display: grid; gap: 0.1rem; padding: 0.8rem 1rem; border-radius: 14px;
      background: rgba(13, 18, 32, 0.62); border: 1px solid var(--border); backdrop-filter: blur(10px);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }
    .stat b { font-family: var(--display); font-weight: 400; font-size: 1.6rem; letter-spacing: 0.05em; color: var(--accent); line-height: 1; }
    .stat span { font-family: var(--mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
    .stat-a { left: -4%; top: 12%; }
    .stat-b { right: -6%; top: 46%; max-width: 13rem; }
    .stat-c { left: 6%; bottom: 8%; }
    @media (max-width: 860px) {
      .thesis { grid-template-columns: 1fr; gap: 1rem; }
      .thesis-art { max-height: 60vh; }
      .stat-a { left: 0; } .stat-b { right: 0; } .stat-c { left: 2%; }
    }

    .block { padding: clamp(3rem, 8vh, 5.5rem) 0; }
    .block-h { font-size: clamp(1.9rem, 5vw, 3rem); font-weight: 600; margin: 0.8rem 0 2rem; }
    .block-h em { font-family: 'Fraunces', serif; font-style: italic; color: var(--accent); }

    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1.1rem; }
    .card { background: rgba(13, 18, 32, 0.55); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; backdrop-filter: blur(8px); transition: border-color 0.2s ease, transform 0.2s ease; }
    .card:hover { border-color: rgba(188, 192, 255, 0.35); transform: translateY(-2px); }
    .card h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }

    .worklist { display: grid; gap: 0.9rem; }
    .workrow { display: grid; grid-template-columns: 12rem 1fr; gap: 1.5rem; align-items: start; background: rgba(13, 18, 32, 0.45); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; backdrop-filter: blur(8px); transition: border-color 0.2s ease; }
    .workrow:hover { border-color: rgba(188, 192, 255, 0.35); }
    .workrow h3 { font-size: 1.4rem; margin-bottom: 0.4rem; }
    .mono { font-family: var(--mono); }
    .tag { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); }
    @media (max-width: 640px) { .workrow { grid-template-columns: 1fr; gap: 0.5rem; } }

    .intro { max-width: 52ch; margin-bottom: 2rem; }
    .intake { display: grid; gap: 1rem; }
    .intake .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; }
    @media (max-width: 560px) { .intake .two { grid-template-columns: minmax(0, 1fr); } }
    .intake label { display: grid; gap: 0.35rem; font-size: 0.85rem; color: var(--muted); }
    .intake input, .intake select, .intake textarea {
      width: 100%; min-width: 0; background: var(--panel-2); border: 1px solid var(--border); border-radius: 12px;
      color: var(--text); padding: 0.75rem 0.9rem; font: inherit; font-size: 0.98rem;
    }
    .intake textarea { resize: vertical; line-height: 1.6; }
    .intake input:focus-visible, .intake select:focus-visible, .intake textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
    .intake-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 0.4rem; }
    .intake-msg { font-size: 0.85rem; }
    .intake-msg.err { color: #ffb4b4; }
    .intake-done { text-align: center; padding: 2rem 0; }
    .intake-done h3 { font-size: 2rem; margin-bottom: 0.6rem; }

    /* Reveal-on-scroll: hidden start state applies ONLY once JS opts in (.reveal-js on
       <html>), so with no JS every section is visible. IntersectionObserver adds .in. */
    .reveal-js [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity 0.7s ease, transform 0.7s ease; }
    [data-reveal].in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) { .reveal-js [data-reveal] { opacity: 1; transform: none; transition: none; } }
  </style>

  <script>
    // Bulletproof reveal via IntersectionObserver (reliable where ScrollTrigger measurement
    // is fragile). Content is visible by default; JS opts into the animated version.
    const els = Array.from(document.querySelectorAll('[data-reveal]'));
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('reveal-js');
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
      els.forEach((el) => io.observe(el));
      // failsafe: never leave anything hidden
      setTimeout(() => els.forEach((el) => el.classList.add('in')), 2500);
    }

    // Intake form → /api/intake
    const form = document.getElementById('intake') as HTMLFormElement | null;
    const msg = form?.querySelector('.intake-msg') as HTMLElement | null;
    const done = document.querySelector('.intake-done') as HTMLElement | null;
    const say = (t: string, err = false) => { if (msg) { msg.textContent = t; msg.className = 'intake-msg' + (err ? ' err' : ''); } };
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload = Object.fromEntries(fd.entries());
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true; say('Sending…');
      try {
        const res = await fetch('/api/intake', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        const data = await res.json();
        if (!res.ok || !data.ok) { btn.disabled = false; return say(data.error || 'Something went wrong — email hello@unakin.com.', true); }
        form.hidden = true; if (done) done.hidden = false;
        done?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
      } catch { btn.disabled = false; say('Network error — try again, or email hello@unakin.com.', true); }
    });
  </script>
</Base>
