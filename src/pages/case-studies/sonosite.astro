    .sketch .fill-accent { fill: var(--accent-c); opacity: 0.18; }
    .sketch .fill-easy { fill: #8bf0cf; opacity: 0.6; }
    .sketch .fill-stretch { fill: #f0d68b; opacity: 0.6; }
    .sketch .fill-ache { fill: #fb7185; opacity: 0.6; }
    .sketch .hand { font-family: var(--hand); fill: var(--ink); font-size: 15px; }
    .sketch .hand.big { font-size: 20px; }
    .sketch .hand.small { font-size: 12.5px; opacity: 0.8; }
    .sketch .hand.accent-txt { fill: var(--accent-c); }
    .sketch .hand.onfill { fill: #1b1f2e; opacity: 1; font-weight: 600; }
    .sketch .strike { stroke: #fb7185; stroke-width: 3; stroke-linecap: round; }
    @media (prefers-reduced-motion: reduce) { .sketch { transform: none !important; } }

    /* the live wheel beat */
    .wheel-wrap { display: grid; grid-template-columns: minmax(14rem, 22rem) 1fr; gap: 2.5rem; align-items: center; }
    @media (max-width: 760px) { .wheel-wrap { grid-template-columns: 1fr; } }
    .device { position: relative; aspect-ratio: 10 / 16; max-height: calc(100vh - 14rem); background: linear-gradient(180deg, #0b0f1a, #070910); border-radius: 26px; box-shadow: 0 30px 70px rgba(0,0,0,.55), inset 0 0 0 2px rgba(188,192,255,.14); overflow: hidden; touch-action: none; user-select: none; }
    .device .scan { position: absolute; inset: 8% 6% 34%; border-radius: 12px; background: radial-gradient(ellipse at 50% 30%, #1c2440 0%, #0b1020 60%, #05070d 100%); overflow: hidden; }
    .device .scan::after { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 2px, transparent 2px 6px); mix-blend-mode: screen; }
    .device .sector { position: absolute; left: 50%; top: 0; width: 120%; height: 100%; transform: translateX(-50%); background: conic-gradient(from 150deg at 50% 0%, transparent 0deg, rgba(139,240,207,.26) 30deg, rgba(139,240,207,.12) 60deg, transparent 60deg); }
    .device .readout { position: absolute; left: 8%; top: 10%; font: 600 0.72rem/1.5 var(--mono); color: var(--text); letter-spacing: 0.1em; }
    .device .readout b { color: var(--mint); font-size: 1.25rem; display: block; letter-spacing: 0.02em; }
    .device .home { position: absolute; left: 8%; bottom: 7%; width: 12%; aspect-ratio: 1; border-radius: 50%; border: 2px solid rgba(188,192,255,.35); display: grid; place-items: center; color: var(--text); font-size: 0.8rem; }
    .wheel { position: absolute; right: -14%; bottom: -14%; width: 62%; aspect-ratio: 1; cursor: grab; outline: none; }
    .wheel:focus-visible { filter: drop-shadow(0 0 0 3px var(--mint)); }
    .wheel:active { cursor: grabbing; }
    .wheel svg { width: 100%; height: 100%; display: block; overflow: visible; }
    .wheel .ring { fill: rgba(188,192,255,.06); stroke: rgba(188,192,255,.25); stroke-width: 1.5; }
    .wheel .hit { fill: transparent; }
    .wheel :global(.tick) { stroke: rgba(188,192,255,.55); stroke-width: 2; stroke-linecap: round; }
    .wheel :global(.tick.major) { stroke: var(--mint); stroke-width: 3; }
    .wheel .thumb-hint { fill: none; stroke: var(--mint); stroke-width: 2; stroke-dasharray: 4 7; opacity: 0.55; }

    .phases { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 1.1rem; margin-top: 0.5rem; }
    .card { background: linear-gradient(180deg, rgba(20,26,44,.6), rgba(13,18,32,.35)); border: 1px solid rgba(188,192,255,.1); border-radius: 18px; padding: 1.3rem 1.4rem; backdrop-filter: blur(8px); }
    .phases h4 { font-family: 'Fraunces', serif; font-size: 1.2rem; margin-bottom: 0.5rem; line-height: 1.3; }
    .phases p { color: var(--muted); line-height: 1.55; font-size: 0.93rem; margin-bottom: 0.6rem; }
    .phases em { color: var(--text); }
    .phases .result { font-family: 'Segoe Print', 'Segoe Script', 'Bradley Hand', 'Chalkboard SE', cursive; color: var(--mint); font-size: 1.05rem; margin-top: 0.6rem; }

    .strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.9rem; margin-top: 0.4rem; }
    @media (max-width: 760px) { .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .shot { margin: 0; background: rgba(13,18,32,.5); border: 1px solid rgba(188,192,255,.1); border-radius: 16px; overflow: hidden; }
    .shot img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: contain; background: #070910; filter: saturate(0.9); }
    .shot figcaption { padding: 0.6rem 0.8rem 0.75rem; font-size: 0.76rem; line-height: 1.4; }

    .video-main { padding: 0.5rem; }
    .video-main video { display: block; width: 100%; border-radius: 12px; background: #000; max-height: 48vh; }
    .video-main .cap { padding: 0.6rem 0.4rem 0.2rem; font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; }
    .yt { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.9rem; }
    .yt iframe { width: 100%; aspect-ratio: 16 / 9; height: auto; border: 0; border-radius: 14px; background: #000; }
    @media (max-width: 760px) { .yt { grid-template-columns: 1fr; } }

    /* deck-only beats + presenter chrome */
    .threads { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0.8rem; margin: 0.8rem 0 0.4rem; }
    .threads .stat { position: relative; display: grid; gap: 0.25rem; padding: 0.95rem 1.05rem; border-radius: 14px; background: linear-gradient(180deg, rgba(20,26,44,.65), rgba(13,18,32,.4)); border: 1px solid rgba(188,192,255,.12); backdrop-filter: blur(10px); box-shadow: 0 10px 40px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.06); }
    .threads .stat b { font-family: var(--display); font-weight: 400; font-size: 1.45rem; letter-spacing: 0.05em; color: var(--accent); line-height: 1; }
    .threads .stat span { font-family: var(--mono); font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); line-height: 1.5; }
    .deck-only { display: none; }
    .cs.deck .deck-only { display: grid; }
    .cs.deck .slide-title .cs-title { font-size: clamp(3rem, 9vw, 7.5rem); }
    .cs.deck .slide-title .lede { max-width: 52ch; font-size: clamp(1.1rem, 1.8vw, 1.4rem); }
    /* the header stays in deck mode; it only leaves in true fullscreen (F) */
    .deck-bar { position: fixed; left: 0; right: 0; top: 0; height: 3px; z-index: 70; background: rgba(255,255,255,.08); }
    .deck-fill { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--violet), var(--accent), var(--mint)); transition: width .4s ease; }
    .deck-notes { position: fixed; left: 14px; bottom: 14px; z-index: 70; width: min(92vw, 34rem); max-height: 42vh; overflow: auto; padding: 1rem 1.2rem; border-radius: 16px; background: rgba(13,18,32,.9); border: 1px solid var(--border); backdrop-filter: blur(14px); box-shadow: 0 20px 60px rgba(0,0,0,.5); }
    .deck-notes-body { margin-top: 0.5rem; font-size: 0.95rem; line-height: 1.6; color: var(--text); white-space: pre-wrap; }
    .deck-cam { position: fixed; left: 14px; bottom: 14px; z-index: 69; width: 12rem; aspect-ratio: 1; border-radius: 50%; overflow: hidden; border: 2px solid rgba(255,255,255,.35); box-shadow: 0 20px 60px rgba(0,0,0,.5); background: #000; }
    .deck-cam video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
    .deck-cam-name { position: absolute; left: 0; right: 0; bottom: 8%; text-align: center; font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase; color: #fff; text-shadow: 0 1px 6px rgba(0,0,0,.8); }
    .deck-notes:not([hidden]) ~ .deck-cam { left: auto; right: 72px; width: 8rem; }
    /* presenter tools injected into the site header once Spacelab Access is detected (JS-created → :global) */
    :global(.deck-tools) { display: inline-flex; gap: 0.5rem; margin-right: 0.4rem; }
    :global(.deck-tool) { display: inline-flex; align-items: center; gap: 0.45rem; font: inherit; font-size: 0.8rem; color: var(--muted); background: none; border: 1px solid var(--border); border-radius: 999px; padding: 0.4rem 0.85rem; cursor: pointer; transition: border-color .2s, color .2s; }
    :global(.deck-tool:hover), :global(.deck-tool:focus-visible) { border-color: var(--accent); color: var(--text); }
    :global(.deck-tool i) { width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,.25); transition: background .2s, box-shadow .2s; }
    :global(.deck-tool.on i) { background: var(--mint); box-shadow: 0 0 10px var(--mint); }
    :global(.deck-tool[aria-pressed="true"]) { border-color: var(--accent); color: var(--text); }
    :global(.deck-legend) { position: fixed; right: 14px; top: 74px; z-index: 71; width: min(92vw, 22rem); padding: 1rem 1.2rem; border-radius: 16px; background: rgba(13,18,32,.92); border: 1px solid var(--border); backdrop-filter: blur(14px); box-shadow: 0 20px 60px rgba(0,0,0,.5); }
    :global(.deck-legend .eyebrow) { margin: 0; }
    :global(.deck-legend-state) { margin: 0.3rem 0 0.6rem; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mint); }
    :global(.deck-legend dl) { display: grid; grid-template-columns: minmax(0, 9.5rem) 1fr; gap: 0.45rem 0.9rem; margin: 0; font-size: 0.88rem; }
    :global(.deck-legend dt) { font-family: var(--mono); font-size: 0.72rem; line-height: 1.5; color: var(--text); }
    :global(.deck-legend dd) { margin: 0; color: var(--muted); }
    :global(.deck-legend-foot) { margin: 0.7rem 0 0; font-size: 0.72rem; color: var(--muted); }
    @media (max-width: 560px) { :global(.deck-tools) { display: none; } }
  </style>

  <script>
    import gsap from 'gsap';
    import '../../components/scroll-progress';

    // ?nomotion=1 = the reduced-motion path on demand (also how the design tooling verifies layout).
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches || new URLSearchParams(location.search).has('nomotion');
    const main = document.querySelector<HTMLElement>('main.cs');

    // Headings that hollow→fill and the hero glint need their text as data for the pseudo layer.
    document.querySelectorAll<HTMLElement>('.glint, .hollow').forEach((el) => { el.dataset.text = el.textContent?.trim() ?? ''; });

    if (main) {
      document.documentElement.classList.add('beats');
      const isDeck = main.hasAttribute('data-deck');
      if (isDeck) document.documentElement.classList.add('deck');
      // Beats = visible top-level sections (deck-only ones only count in deck mode).
      const beats = Array.from(main.querySelectorAll<HTMLElement>(':scope > section')).filter((s) => isDeck || !s.classList.contains('deck-only'));
      beats.forEach((s) => { if (s.querySelector(':scope > .sketch')) s.classList.add('has-sketch'); });

      // ── per-beat enter animations (play to completion; reset on leave so they replay) ──
      type Anim = { enter: () => gsap.core.Timeline | void; reset: () => void };
      const anims = new Map<HTMLElement, Anim>();
      for (const s of beats) {
        const tl = () => gsap.timeline({ defaults: { ease: 'power3.out' } });
        const sketch = s.querySelector<SVGSVGElement>('.sketch svg');
        const strokes = sketch ? Array.from(sketch.querySelectorAll<SVGGeometryElement>('.ink, .ink-thin, .accent, .strike')) : [];
        const lengths = strokes.map((el) => el.getTotalLength());
        const rest = sketch ? Array.from(sketch.querySelectorAll('text, .fill-accent, .fill-easy, .fill-stretch, .fill-ache')) : [];
        const hollow = s.querySelector<HTMLElement>('.hollow');
        const lines = Array.from(s.querySelectorAll<HTMLElement>('.leadin h3, .lede, .cite, .keypoints, .eyebrow, .hint'));
        const cards = Array.from(s.querySelectorAll<HTMLElement>('.persona, .breakdown > div, .phases .card, .shot, .threads .stat, .device, .wheel-copy, .video-main, .yt'));
        const reset = () => {
          if (reduced) return;
          strokes.forEach((el, i) => { el.style.strokeDasharray = `${lengths[i]}`; el.style.strokeDashoffset = `${lengths[i]}`; });
          if (rest.length) gsap.set(rest, { opacity: 0 });
          if (hollow) hollow.style.setProperty('--unfill', '100%');
          if (lines.length || cards.length) gsap.set([...lines, ...cards], { opacity: 0, y: 18 });
          const fig = s.querySelector('.sketch'); if (fig) gsap.set(fig, { opacity: 0, y: 24 });
        };
        const enter = () => {
          if (reduced) { if (hollow) hollow.style.setProperty('--unfill', '0%'); return; }
          const t = tl();
          if (hollow) t.to(hollow, { '--unfill': '0%', duration: 0.9, ease: 'power2.inOut' }, 0);
          if (lines.length) t.to(lines, { opacity: 1, y: 0, duration: 0.7, stagger: 0.08 }, 0.1);
          if (cards.length) t.to(cards, { opacity: 1, y: 0, duration: 0.7, stagger: 0.07 }, 0.25);
          const fig = s.querySelector('.sketch');
          if (fig) t.to(fig, { opacity: 1, y: 0, duration: 0.6 }, 0.15);
          if (strokes.length) t.to(strokes, { strokeDashoffset: 0, duration: 1.4, ease: 'power1.inOut', stagger: { each: 0.012 } }, 0.35);
          if (rest.length) t.to(rest, { opacity: 1, duration: 0.5, stagger: 0.02, ease: 'power1.out' }, 1.2);
          return t;
        };
        anims.set(s, { enter, reset });
        reset();
      }

      // ── navigation ──
      let cur = -1, busy = false, lastGoAt = -1e9;
      const fill = document.querySelector<HTMLElement>('.deck-fill');
      const notesBody = document.querySelector<HTMLElement>('.deck-notes-body');
      const notes = document.querySelector<HTMLElement>('.deck-notes');
      const progress = document.querySelector<HTMLElement>('scroll-progress');
      // Skip link (first in tab order, visible on focus) → opens the story-arc navigation.
      const skip = document.createElement('a'); skip.className = 'skip-link'; skip.href = '#arc'; skip.textContent = 'Skip to story navigation';
      document.body.prepend(skip);
      // big hollow beat numeral (depth, and a quiet "where am I")
      let numT = 0;
      const num = document.createElement('div'); num.className = 'beat-num'; num.setAttribute('aria-hidden', 'true'); document.body.append(num);
      const hint = document.createElement('p'); hint.className = 'beat-hint'; hint.textContent = isDeck ? '→ next · ← back · N notes · F fullscreen' : '↓ scroll or → to continue'; document.body.append(hint);

      const paint = (i: number) => {
        if (fill) fill.style.width = `${((i + 1) / beats.length) * 100}%`;
        // the counter shows for a moment on each change, then fades
        progress?.setAttribute('label', `${i + 1} / ${beats.length}`);
        num.classList.add('show');
        clearTimeout(numT); numT = window.setTimeout(() => { num.classList.remove('show'); progress?.setAttribute('label', ''); }, 2000);
        progress?.setAttribute('progress', String(i / Math.max(1, beats.length - 1)));
        if (notesBody) notesBody.textContent = beats[i].dataset.notes ?? '(no notes for this beat)';
        history.replaceState(null, '', `#b${i + 1}`);
        hint.style.opacity = i >= beats.length - 1 ? '0' : '';
        num.innerHTML = i === 0 ? '' : `${String(i + 1).padStart(2, '0')}<small> / ${beats.length}</small>`;
        window.dispatchEvent(new Event('beatchange'));
        document.querySelectorAll<HTMLButtonElement>('.beat-zone.prev').forEach((z) => z.toggleAttribute('disabled', i <= 0));
        document.querySelectorAll<HTMLButtonElement>('.beat-zone.next').forEach((z) => z.toggleAttribute('disabled', i >= beats.length - 1));
      };

      const go = (i: number) => {
        i = Math.max(0, Math.min(beats.length - 1, i));
        // hard rate limit: no source (proxy, keys, extension, narration) advances more than one beat per 400ms
        if (performance.now() - lastGoAt < 400) return;
        if (i === cur || busy) return;
        lastGoAt = performance.now();
        ((window as any).__golog ??= []).push({ t: Math.round(performance.now()), from: cur, to: i, stack: (new Error().stack ?? '').split('\n').slice(1, 9).map((l) => l.trim().replace(/https?:\/\/[^/]+\/_astro\//, '')).join(' | ') });
        busy = true;
        const prev = cur >= 0 ? beats[cur] : null, next = beats[i];
        const dir = i > cur ? 1 : -1;
        cur = i; paint(i);
        const done = () => { busy = false; };
        if (reduced) {
          prev?.classList.remove('active'); next.classList.add('active'); anims.get(next)?.enter(); done(); return;
        }
        // Cinematic hand-off (davidpuerto.com energy): the leaving beat pans away and recedes while
        // the arriving beat is already coming in from slightly large — both on screen at once.
        // One-off: the hero is a full-bleed photograph — shrinking it during an overlap shows its
        // edge as a hard line. So the hero simply fades to black, completely, and only then does
        // the next beat come in.
        const heroOut = !!prev?.classList.contains('cs-hero');
        const inAt = !prev ? 0 : heroOut ? 0.7 : 0.12;
        const t = gsap.timeline({ onComplete: done });
        if (prev) {
          const out = heroOut
            ? { opacity: 0, duration: 0.65, ease: 'power2.inOut' }
            : { opacity: 0, yPercent: -7 * dir, scale: 0.93, filter: 'blur(6px)', duration: 0.75, ease: 'power2.inOut' };
          t.to(prev, { ...out, onComplete: () => { prev.classList.remove('active'); gsap.set(prev, { clearProps: 'transform,opacity,filter' }); anims.get(prev)?.reset(); } }, 0);
        }
        t.add(() => { next.classList.add('active'); }, inAt);
        t.fromTo(next, { opacity: 0, yPercent: 9 * dir, scale: 1.07, filter: 'blur(4px)' }, { opacity: 1, yPercent: 0, scale: 1, filter: 'blur(0px)', duration: 0.95, ease: 'power3.out' }, inAt);
        t.add(() => { anims.get(next)?.enter(); }, inAt + (prev ? 0.23 : 0.15));
      };

      // wheel → one beat per gesture (throttled); ignore the depth wheel and inner scrollers
      let lastWheel = 0;
      window.addEventListener('wheel', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.wheel, .deck-notes')) return;
        const inner = target.closest<HTMLElement>('.cs > section');
        if (inner && inner.scrollHeight > inner.clientHeight + 4) { // a tall beat scrolls inside itself first
          const atEnd = e.deltaY > 0 ? inner.scrollTop + inner.clientHeight >= inner.scrollHeight - 2 : inner.scrollTop <= 0;
          if (!atEnd) return;
        }
        e.preventDefault();
        const now = performance.now();
        if (now - lastWheel < 900 || Math.abs(e.deltaY) < 8) return;
        lastWheel = now; go(cur + (e.deltaY > 0 ? 1 : -1));
      }, { passive: false });
      // touch: native swipe scrolls the parked window → the scroll proxy below turns it into a beat move
      // keys
      window.addEventListener('keydown', (e) => {
        if ((e.target as HTMLElement)?.closest('input, textarea, select, [role=slider]')) return;
        if (['ArrowRight', 'ArrowDown', 'PageDown', ' '].includes(e.key)) { e.preventDefault(); go(cur + 1); }
        else if (['ArrowLeft', 'ArrowUp', 'PageUp'].includes(e.key)) { e.preventDefault(); go(cur - 1); }
        else if (e.key === 'Home') { e.preventDefault(); go(0); }
        else if (e.key === 'End') { e.preventDefault(); go(beats.length - 1); }
        else if (e.key.toLowerCase() === 'n' && notes) notes.hidden = !notes.hidden;
        else if (e.key.toLowerCase() === 'f') { document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen?.(); }
      });
      // ── the arc map: Freytag's triangle with every beat plotted on it ──
      // Stage geometry from position: the climax beat(s) sit at the apex (data-stage="climax";
      // standalone mode uses data-stage-cs); everything before rises toward it, after falls away.
      const STAGES = ['Exposition', 'Rising action', 'Climax', 'Falling action', 'Resolution'] as const;
      const climaxIdx = beats.map((s, i) => ((isDeck ? s.dataset.stage : s.dataset.stageCs ?? s.dataset.stage) === 'climax' ? i : -1)).filter((i) => i >= 0);
      const peakStart = climaxIdx.length ? climaxIdx[0] : Math.round(beats.length * 0.62);
      const peakEnd = climaxIdx.length ? climaxIdx[climaxIdx.length - 1] : peakStart;
      const EXPLICIT: Record<string, (typeof STAGES)[number]> = { exposition: 'Exposition', rising: 'Rising action', climax: 'Climax', falling: 'Falling action', resolution: 'Resolution' };
      const stageOf = (i: number): (typeof STAGES)[number] => {
        const s = beats[i]; const ex = (isDeck ? s.dataset.stage : s.dataset.stageCs ?? s.dataset.stage) ?? '';
        if (EXPLICIT[ex]) return EXPLICIT[ex];
        if (i >= peakStart && i <= peakEnd) return 'Climax';
        if (i < peakStart) return i < Math.max(1, Math.round(peakStart * 0.3)) ? 'Exposition' : 'Rising action';
        const tail = beats.length - 1 - peakEnd;
        return i >= peakEnd + 1 + Math.max(1, Math.floor(tail * 0.6)) ? 'Resolution' : 'Falling action';
      };
      // Title = the heading with <br> read as a space; beats without an h1/h2 use their eyebrow or first line.
      const titleOf = (s: HTMLElement) => {
        const h = s.querySelector('h1, h2, .eyebrow, h3, h6');
        const html = h ? h.innerHTML.replace(/<br\s*\/?>/gi, ' ').replace(/<[^>]+>/g, '') : '';
        const txt = html.replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim();
        return txt || `Beat ${beats.indexOf(s) + 1}`;
      };
      // plot: x across the beats; y = pyramid with the apex over the climax span
      const W = 1000, H = 300, PAD = 60, APEX = 40, BASE = 230;
      const px = (i: number) => PAD + (i / Math.max(1, beats.length - 1)) * (W - PAD * 2);
      const py = (i: number) => {
        if (i < peakStart) return BASE - (BASE - APEX) * (i / Math.max(1, peakStart));
        if (i <= peakEnd) return APEX;
        return APEX + (BASE - APEX) * ((i - peakEnd) / Math.max(1, beats.length - 1 - peakEnd));
      };
      const toc = document.createElement('div'); toc.className = 'arc-toc'; toc.setAttribute('role', 'dialog'); toc.setAttribute('aria-label', 'Story arc — all beats');
      const pathD = beats.map((_, i) => `${i ? 'L' : 'M'}${px(i).toFixed(1)} ${py(i).toFixed(1)}`).join(' ');
      const stageX = (name: (typeof STAGES)[number]) => { const idx = beats.map((_, i) => i).filter((i) => stageOf(i) === name); return idx.length ? (px(idx[0]) + px(idx[idx.length - 1])) / 2 : -999; };
      toc.innerHTML = `
        <div class="arc-toc-head"><h2 class="display-h">The story arc</h2><div class="arc-toc-actions"><a class="arc-toc-close" href="${isDeck ? '/case-studies/sonosite' : '/case-studies/sonosite?deck=1'}">${isDeck ? 'Case study · 15 beats' : 'Full deck · 28 beats'} →</a><button type="button" class="arc-toc-close">Close · Esc</button></div></div>
        <div class="arc-body">
          <svg class="arc-svg" viewBox="0 0 ${W} ${H}" aria-hidden="true">
            <defs><linearGradient id="arc-grad" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#6d4aff"/><stop offset=".6" stop-color="#bcc0ff"/><stop offset="1" stop-color="#8bf0cf"/></linearGradient></defs>
            <line class="base" x1="${PAD}" y1="${BASE + 18}" x2="${W - PAD}" y2="${BASE + 18}"/>
            <path class="pyramid" d="${pathD}"/>
            <path class="done" d="${pathD}"/>
            <text class="peak" x="${(px(peakStart) + px(peakEnd)) / 2}" y="${APEX - 16}" text-anchor="middle">Climax</text>
            ${STAGES.filter((n) => n !== 'Climax').map((n) => { const idx = beats.map((_, i) => i).filter((i) => stageOf(i) === n); if (!idx.length) return ''; const anchor = n === 'Exposition' ? 'start' : n === 'Resolution' ? 'end' : 'middle'; const x = n === 'Exposition' ? px(idx[0]) : n === 'Resolution' ? px(idx[idx.length - 1]) : stageX(n); const y = n === 'Falling action' ? BASE + 64 : BASE + 44; return `<text class="stage" data-stage="${n}" x="${x}" y="${y}" text-anchor="${anchor}">${n}</text>`; }).join('')}
            ${beats.map((_, i) => `<circle class="dot" data-i="${i}" cx="${px(i)}" cy="${py(i)}" r="6"><title>${i + 1}. ${titleOf(beats[i]).replace(/"/g, '&quot;')}</title></circle>`).join('')}
          </svg>
          <div class="arc-list">
            ${STAGES.map((n) => `<div class="arc-col" data-stage="${n}"><h4>${n}</h4><ol>${beats.map((s, i) => stageOf(i) === n ? `<li><button type="button" data-i="${i}"><small>${String(i + 1).padStart(2, '0')}</small>${titleOf(s)}</button></li>` : '').join('')}</ol></div>`).join('')}
          </div>
        </div>`;
      document.body.append(toc);
      const donePath = toc.querySelector<SVGPathElement>('.done')!; const doneLen = donePath.getTotalLength();
      donePath.style.strokeDasharray = `${doneLen}`; donePath.style.strokeDashoffset = `${doneLen}`;
      const paintToc = () => {
        toc.querySelectorAll<SVGCircleElement>('.dot').forEach((d) => { const i = +d.dataset.i!; d.classList.toggle('now', i === cur); d.classList.toggle('past', i < cur); });
        toc.querySelectorAll<HTMLButtonElement>('.arc-col button').forEach((b) => { const i = +b.dataset.i!; b.classList.toggle('now', i === cur); b.classList.toggle('past', i < cur); });
        const st = stageOf(cur);
        toc.querySelectorAll<HTMLElement>('.arc-col h4').forEach((h) => h.classList.toggle('on', h.parentElement!.dataset.stage === st));
        toc.querySelectorAll<SVGTextElement>('.stage').forEach((t) => t.classList.toggle('on', t.dataset.stage === st));
        // the gradient line grows to the current beat
        const frac = beats.length > 1 ? cur / (beats.length - 1) : 1;
        donePath.style.strokeDashoffset = `${doneLen * (1 - frac)}`;
      };
      let tocReturn: HTMLElement | null = null;
      const openToc = () => { paintToc(); tocReturn = document.activeElement as HTMLElement; toc.classList.add('open'); setTimeout(() => (toc.querySelector<HTMLButtonElement>('.arc-col button.now') ?? toc.querySelector<HTMLButtonElement>('.arc-col button'))?.focus(), 60); };
      const closeToc = () => { toc.classList.remove('open'); tocReturn?.focus?.(); };
      skip.addEventListener('click', (e) => { e.preventDefault(); openToc(); });
      toc.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const i = t.closest<HTMLElement>('[data-i]')?.dataset.i;
        if (i !== undefined) { closeToc(); go(+i); return; }
        if (t.closest('.arc-toc-close') || t === toc) closeToc();
      });
      window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeToc(); else if (e.key.toLowerCase() === 't') { toc.classList.contains('open') ? closeToc() : openToc(); } });
      // ── narration: S speaks the current beat. Prefers David's own clip
      //    (/audio/sonosite/beat-NN.mp3 — HeyGen voice clone), falls back to the browser's voice
      //    reading the on-screen copy. Stops on beat change. Also a live demo of ear-navigable beats.
      let clip: HTMLAudioElement | null = null; let speaking = false;
      if ('speechSynthesis' in window) { speechSynthesis.getVoices(); speechSynthesis.addEventListener?.('voiceschanged', () => speechSynthesis.getVoices()); }
      if (new URLSearchParams(location.search).has('voices')) setTimeout(() => console.table(speechSynthesis.getVoices().filter((v) => /^en/i.test(v.lang)).map((v) => ({ name: v.name, lang: v.lang, local: v.localService }))), 800);
      const stopSpeech = () => { speaking = false; try { speechSynthesis.cancel(); } catch {} if (clip) { clip.pause(); clip = null; } };
      const speak = (i: number, onEnd?: () => void) => {
        stopSpeech(); speaking = true;
        const s = beats[i];
        // Speakable text: heading, then each paragraph as its own sentence run. Em-dashes, quotes,
        // bullets and glued spans are what make TTS pause strangely — normalise them first.
        const clean = (t: string) => t.replace(/\s+/g, ' ').replace(/\s*[—–]\s*/g, ', ').replace(/[“”"◆→·]/g, '').replace(/\s+([,.;:!?])/g, '$1').replace(/([a-z0-9])\s*\.\s*([A-Z])/g, '$1. $2').trim();
        const parts = [s.querySelector('h1, h2')?.textContent ?? '', ...Array.from(s.querySelectorAll('.lede, .leadin h3')).map((el) => (el.querySelector('em')?.textContent ?? '') + ' ' + (el.querySelector('span')?.textContent ?? (el.matches('.leadin h3') ? '' : el.textContent ?? '')))]
          .map(clean).filter(Boolean).map((p) => (/[.!?]$/.test(p) ? p : p + '.'));
        const text = parts.join(' ');
        const nn = String(i + 1).padStart(2, '0');
        const a = new Audio(`/audio/sonosite/${isDeck ? 'deck-' : 'beat-'}${nn}.mp3`);
        a.addEventListener('canplay', () => { if (!speaking) return; clip = a; a.addEventListener('ended', () => { if (speaking) { speaking = false; onEnd?.(); } }, { once: true }); a.play().catch(() => fallback()); }, { once: true });
        a.addEventListener('error', () => { if (speaking) fallback(); }, { once: true });
        const fallback = () => {
          if (!('speechSynthesis' in window) || !text) return;
          // Voice: ?voice=Name wins; else Apple Premium/Enhanced (Ava, Zoe, Evan, Tom…) → Google US English → any en-US.
          // ?voice=Name is remembered in this browser (localStorage) so it sticks across visits.
          const qv = new URLSearchParams(location.search).get('voice');
          if (qv) { try { localStorage.setItem('sl.voice', qv); } catch {} }
          let want = qv; if (!want) { try { want = localStorage.getItem('sl.voice'); } catch {} }
          const voices = speechSynthesis.getVoices();
          const pick = () => (want && voices.find((v) => v.name.toLowerCase().includes(want.toLowerCase())))
            ?? voices.find((v) => /en[-_]US/i.test(v.lang) && /(Premium|Enhanced)/i.test(v.name))
            ?? voices.find((v) => /^en/i.test(v.lang) && /(Premium|Enhanced)/i.test(v.name))   // e.g. Lee (Premium), en-AU
            ?? voices.find((v) => /en[-_]US/i.test(v.lang) && /^(Ava|Zoe|Evan|Tom|Allison|Nicky)\b/i.test(v.name))
            ?? voices.find((v) => /Google US English/i.test(v.name))
            ?? voices.find((v) => /en[-_]US/i.test(v.lang) && /Samantha|Alex/i.test(v.name))
            ?? voices.find((v) => /^en/i.test(v.lang));
          const v = pick();
          // one utterance per sentence run → natural pauses between paragraphs, no run-ons
          const chunks = parts.length ? parts : [text];
          chunks.forEach((chunk, k) => {
            const u = new SpeechSynthesisUtterance(chunk); u.rate = 1.0; u.pitch = 1.0; if (v) u.voice = v;
            if (k === chunks.length - 1) u.onend = () => { if (speaking) { speaking = false; onEnd?.(); } };
            speechSynthesis.speak(u);
          });
        };
      };
      // Auto-narrate (?narrate=1 or Shift+S): each beat speaks on arrival and advances when the clip ends.
      let narrate = new URLSearchParams(location.search).get('narrate') === '1';
      (window as any).__diag = () => ({ narrate, speaking, cur });
      const narrateBeat = () => speak(cur, () => { if (narrate && cur < beats.length - 1) go(cur + 1); });
      window.addEventListener('keydown', (e) => {
        if ((e.target as HTMLElement)?.closest('input, textarea, select')) return;
        if (e.key === 'S' && e.shiftKey) { narrate = !narrate; narrate ? narrateBeat() : stopSpeech(); }
        else if (e.key.toLowerCase() === 's') { speaking ? stopSpeech() : speak(cur); }
      });
      window.addEventListener('beatchange', () => { stopSpeech(); if (narrate) setTimeout(narrateBeat, 900); }); // paint() fires this on every beat change
      if (narrate) setTimeout(narrateBeat, 1200);

      // ── Spacelab Access (the extension) external interface ──
      // The extension's page-world cursor exposes SLCursor.bus. "next"/"back" arrive as cursor:nav;
      // every final spoken phrase arrives as voice:phrase and the page may claim it (ev.handled).
      const hookCursor = () => {
        const SL = (window as any).SLCursor; if (!SL?.bus || (SL as any).__deckHooked) return !!SL?.bus;
        (SL as any).__deckHooked = true;
        SL.bus.on('cursor:nav', (d: { dir: string }) => go(cur + (d?.dir === 'prev' ? -1 : 1)));
        SL.bus.on('voice:phrase', (ev: { text: string; handled: boolean }) => {
          const t = (ev.text || '').toLowerCase();
          const claim = (fn: () => void) => { ev.handled = true; fn(); };
          const num = t.match(/\b(?:beat|slide|go to|jump to)\s+(\d{1,2})\b/);
          if (num) return claim(() => go(parseInt(num[1], 10) - 1));
          if (/\b(story arc|the arc|the map|table of contents|contents|overview)\b/.test(t)) return claim(openToc);
          if (/\b(close|dismiss|hide)\b/.test(t) && toc.classList.contains('open')) return claim(closeToc);
          if (/\b(stop reading|stop speaking|quiet|shush|be quiet)\b/.test(t)) return claim(stopSpeech);
          if (/\b(read|speak|narrate)\b/.test(t)) return claim(() => speak(cur));
          if (/\b(notes|talking points)\b/.test(t) && notes) return claim(() => { notes.hidden = !notes.hidden; });
          if (/\b(first|start over|beginning)\b/.test(t)) return claim(() => go(0));
          if (/\b(last|the end|finish)\b/.test(t)) return claim(() => go(beats.length - 1));
          if (/\b(full ?screen)\b/.test(t)) return claim(() => { document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen?.(); });
        });
        return true;
      };
      if (!hookCursor()) { const iv = setInterval(() => { if (hookCursor()) clearInterval(iv); }, 500); setTimeout(() => clearInterval(iv), 20000); }

      // ── Presenter tools in the site header (deck only, and only once the extension is present) ──
      // "Eyes" opens the full-page gaze calibration (SLCursor.calibrate) or closes it if it's up;
      // "Voice" shows the command legend + live mic state. Both live in the header per David's ask
      // so the calibration can cover the whole page first and come back on demand.
      const mountTools = () => {
        const SL = (window as any).SLCursor; const nav = document.querySelector('header.nav .navlinks');
        if (!SL?.bus || !nav || document.querySelector('.deck-tools')) return !!SL?.bus;
        const tools = document.createElement('span'); tools.className = 'deck-tools';
        tools.innerHTML = `<button type="button" class="deck-tool" data-tool="eyes" aria-pressed="false"><i></i>Eyes</button><button type="button" class="deck-tool" data-tool="voice" aria-expanded="false" aria-controls="deck-voice-legend"><i></i>Voice</button>`;
        nav.prepend(tools);
        const eyes = tools.querySelector<HTMLButtonElement>('[data-tool=eyes]')!, voice = tools.querySelector<HTMLButtonElement>('[data-tool=voice]')!;
        const legend = document.createElement('aside'); legend.id = 'deck-voice-legend'; legend.className = 'deck-legend'; legend.hidden = true; legend.setAttribute('aria-label', 'Voice commands');
        legend.innerHTML = `<p class="eyebrow">Voice · say any of these</p><p class="deck-legend-state"></p>
          <dl><dt>next · back</dt><dd>move one beat</dd><dt>beat 12</dt><dd>jump to a beat</dd><dt>first · last</dt><dd>the ends</dd>
          <dt>story arc</dt><dd>open the map · “close” hides it</dd><dt>read · stop reading</dt><dd>narrate this beat</dd><dt>notes</dt><dd>talking points</dd>
          <dt>full screen</dt><dd>toggle</dd><dt>eyes on · eyes off · calibrate</dt><dd>gaze steering</dd><dt>click · open</dt><dd>activate what the cursor is on</dd></dl>
          <p class="deck-legend-foot">Esc or “close” hides this.</p>`;
        document.body.append(legend);
        const state = legend.querySelector<HTMLElement>('.deck-legend-state')!;
        const paintVoice = (on: boolean, err?: string) => { voice.classList.toggle('on', on); state.textContent = err === 'not-allowed' || err === 'service-not-allowed' ? 'Mic blocked for this site — click the camera/mic icon in the address bar, allow, reload.' : on ? 'Listening.' : 'Mic off.'; };
        paintVoice(!!SL.voiceOn?.());
        SL.bus.on('voice:state', (d: { on: boolean; error?: string }) => paintVoice(!!d?.on, d?.error));
        const paintEyes = (open: boolean) => { eyes.classList.toggle('on', !!SL.gazeOn?.()); eyes.setAttribute('aria-pressed', String(open)); };
        SL.bus.on('gaze:calibration', (d: { open: boolean }) => paintEyes(!!d?.open));
        eyes.addEventListener('click', () => { if (eyes.getAttribute('aria-pressed') === 'true') SL.closeCalibration?.(); else SL.calibrate?.(); });
        const showLegend = (on: boolean) => { legend.hidden = !on; voice.setAttribute('aria-expanded', String(on)); };
        voice.addEventListener('click', () => showLegend(legend.hidden));
        window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !legend.hidden) showLegend(false); });
        SL.bus.on('voice:phrase', (ev: { text: string; handled: boolean }) => {
          const t = (ev.text || '').toLowerCase();
          if (/\b(what can i say|voice help|commands|help)\b/.test(t)) { ev.handled = true; showLegend(true); }
          else if (/\b(close|dismiss|hide)\b/.test(t) && !legend.hidden && !ev.handled) { ev.handled = true; showLegend(false); }
        });
        return true;
      };
      if (isDeck && !mountTools()) { const iv = setInterval(() => { if (mountTools()) clearInterval(iv); }, 500); setTimeout(() => clearInterval(iv), 20000); }

      // the book puck opens the map (no more back-to-top)
      progress?.addEventListener('totop', (e) => { e.preventDefault(); toc.classList.contains('open') ? closeToc() : openToc(); });

      // edge zones: big prev / next buttons a hand cursor (or a finger) can hit
      const mkZone = (dir: -1 | 1) => { const b = document.createElement('button'); b.type = 'button'; b.className = `beat-zone ${dir < 0 ? 'prev' : 'next'}`; b.setAttribute('aria-label', dir < 0 ? 'Previous beat' : 'Next beat'); b.textContent = dir < 0 ? '‹' : '›'; b.addEventListener('click', () => go(cur + dir)); document.body.append(b); return b; };
      const zPrev = mkZone(-1), zNext = mkZone(1);
      const paintZones = () => { zPrev.toggleAttribute('disabled', cur <= 0); zNext.toggleAttribute('disabled', cur >= beats.length - 1); };
      zPrev.addEventListener('click', paintZones); zNext.addEventListener('click', paintZones);

      // scroll proxy: the window is parked at 1 screen down; any window scroll (extension fist /
      // voice "down" / "up" / "top" / "bottom", assistive tech) becomes a beat move, then re-parks.
      const park = () => window.scrollTo({ top: window.innerHeight, behavior: 'auto' });
      let parking = true; // ignore the browser's own restore + our first park
      history.scrollRestoration = 'manual';
      park();
      setTimeout(() => { parking = false; }, 400);
      window.addEventListener('scroll', () => {
        if (parking) return;
        const dy = window.scrollY - window.innerHeight;
        if (Math.abs(dy) < 40) return;
        parking = true;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        if (window.scrollY <= 1) go(0); else if (window.scrollY >= max - 1) go(beats.length - 1); else go(cur + (dy > 0 ? 1 : -1));
        park(); paintZones();
        setTimeout(() => { parking = false; }, 700);
      }, { passive: true });
      // A resize (fullscreen toggle, screen-share, window drag) changes innerHeight, which would
      // make the parked position read as a scroll — guard, re-park, release.
      let resizeT = 0;
      window.addEventListener('resize', () => { parking = true; park(); clearTimeout(resizeT); resizeT = window.setTimeout(() => { parking = false; }, 500); }, { passive: true });
      paintZones();

      // hero: slow ken-burns on the scan while the hero beat is up
      const heroImg = document.querySelector<HTMLElement>('.hero-bg img');
      if (heroImg && !reduced) gsap.fromTo(heroImg, { scale: 1.08, xPercent: 1 }, { scale: 1, xPercent: -1, duration: 14, ease: 'sine.inOut', repeat: -1, yoyo: true });

      // presenter camera (?cam=1)
      if (new URLSearchParams(location.search).get('cam') === '1' && navigator.mediaDevices?.getUserMedia) {
        const cam = document.querySelector<HTMLElement>('.deck-cam'); const video = cam?.querySelector('video');
        navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: 640, height: 640 }, audio: false })
          .then((stream) => { if (cam && video) { video.srcObject = stream; cam.hidden = false; } })
          .catch((err) => console.warn('camera unavailable:', err));
      }

      const start = Math.max(0, Math.min(beats.length - 1, (parseInt((location.hash.match(/#b(\d+)/) ?? [])[1] ?? '1', 10) || 1) - 1));
      go(start);
    }

    // The live radial thumb-wheel — the 2013 idea in 2026 componentry: drag/spin with pointer
    // or thumb, momentum + friction under the pad, oversized invisible hitbox, keyboard-nudgeable.
    const wheel = document.querySelector<HTMLElement>('.wheel');
    if (wheel) {
      const rotor = wheel.querySelector<SVGGElement>('.rotor')!;
      const ticks = wheel.querySelector('.ticks')!;
      const readout = document.querySelector<HTMLElement>('.readout b');
      let s = '';
      for (let i = 0; i < 36; i++) { const a = i * 10 * Math.PI / 180, r1 = i % 9 === 0 ? 62 : 70, r2 = 84;
        s += `<line class="tick${i % 9 === 0 ? ' major' : ''}" x1="${100 + Math.cos(a) * r1}" y1="${100 + Math.sin(a) * r1}" x2="${100 + Math.cos(a) * r2}" y2="${100 + Math.sin(a) * r2}"/>`; }
      ticks.innerHTML = s;

      let angle = 0, vel = 0, dragging = false, lastA = 0, lastT = 0, raf = 0;
      const MIN = 2, MAX = 30, START = 12.4;
      const center = () => { const r = wheel.getBoundingClientRect(); return { x: r.left + r.width / 2, y: r.top + r.height / 2 }; };
      const angleAt = (e: PointerEvent) => { const c = center(); return Math.atan2(e.clientY - c.y, e.clientX - c.x) * 180 / Math.PI; };
      const depth = () => Math.min(MAX, Math.max(MIN, START + angle / 36)); // 36° per cm
      const paint = () => { rotor.style.transform = `rotate(${angle}deg)`; const d = depth(); if (readout) readout.textContent = d.toFixed(1) + ' cm'; wheel.setAttribute('aria-valuenow', d.toFixed(1)); };
      const tick = () => { if (dragging || Math.abs(vel) < 0.05) { vel = 0; raf = 0; return; } angle += vel; vel *= 0.94; paint(); raf = requestAnimationFrame(tick); };
      wheel.addEventListener('pointerdown', (e) => { dragging = true; vel = 0; cancelAnimationFrame(raf); raf = 0; lastA = angleAt(e); lastT = performance.now(); wheel.setPointerCapture(e.pointerId); });
      wheel.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const a = angleAt(e); let d = a - lastA; if (d > 180) d -= 360; if (d < -180) d += 360;
        angle += d; lastA = a; const now = performance.now(); vel = d / Math.max(1, now - lastT) * 16; lastT = now; paint();
      });
      const release = () => { if (!dragging) return; dragging = false; if (reduced) { vel = 0; return; } if (!raf) raf = requestAnimationFrame(tick); };
      wheel.addEventListener('pointerup', release); wheel.addEventListener('pointercancel', release);
      wheel.addEventListener('keydown', (e) => {
        const step = e.shiftKey ? 36 : 9;
        if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { angle += step; paint(); e.preventDefault(); e.stopPropagation(); }
        if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { angle -= step; paint(); e.preventDefault(); e.stopPropagation(); }
      });
      paint();
    }
  </script>
</Base>
