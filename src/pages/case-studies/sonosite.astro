    .phases h4 { font-family: 'Fraunces', serif; font-size: 1.25rem; margin-bottom: 0.6rem; line-height: 1.3; }
    .phases p { color: var(--muted); line-height: 1.6; font-size: 0.95rem; margin-bottom: 0.7rem; }
