    .lock-form input { font: inherit; font-family: system-ui, sans-serif; font-size: 1.05rem; letter-spacing: 0.1em; color: var(--text); padding: 0.85rem 1rem; border-radius: 14px; background: rgba(255,255,255,.05); border: 1px solid rgba(188,192,255,.18); }
