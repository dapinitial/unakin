    :global(.beats-nav) { position: fixed; right: 16px; top: 50%; translate: 0 -50%; z-index: 60; display: grid; gap: 6px; }
    :global(.beats-nav button) { width: 26px; height: 22px; padding: 0; border: 0; background: transparent; cursor: pointer; display: grid; place-items: center; }
