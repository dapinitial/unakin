  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import '../../components/scroll-progress';
    gsap.registerPlugin(ScrollTrigger);

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Deck engine (?deck=1): slides = top-level sections; arrows / space / PgUp-PgDn move,
    //    Home/End jump, N toggles speaker notes, F fullscreen, ?cam=1 shows the presenter camera.
    const deckMain = document.querySelector<HTMLElement>('main.cs[data-deck]');
    if (deckMain) {
      document.documentElement.classList.add('deck');
      const slides = Array.from(deckMain.querySelectorAll<HTMLElement>(':scope > section'));
      const fill = document.querySelector<HTMLElement>('.deck-fill');
      const notes = document.querySelector<HTMLElement>('.deck-notes');
      const notesBody = document.querySelector<HTMLElement>('.deck-notes-body');
      const progress = document.querySelector<HTMLElement>('scroll-progress');
      let cur = 0;
      const current = () => {
        const y = window.scrollY + window.innerHeight * 0.35;
        let i = 0; for (let k = 0; k < slides.length; k++) if (slides[k].offsetTop <= y) i = k;
        return i;
      };
      const paint = () => {
        cur = current();
        if (fill) fill.style.width = `${((cur + 1) / slides.length) * 100}%`;
        progress?.setAttribute('label', `${cur + 1} / ${slides.length}`);
        if (notesBody) notesBody.textContent = slides[cur].dataset.notes ?? '(no notes for this slide)';
      };
      const go = (i: number) => { const t = slides[Math.max(0, Math.min(slides.length - 1, i))]; window.scrollTo({ top: t.offsetTop, behavior: reduced ? 'auto' : 'smooth' }); };
      window.addEventListener('scroll', paint, { passive: true });
      window.addEventListener('keydown', (e) => {
        if ((e.target as HTMLElement)?.closest('input, textarea, select, [role=slider]')) return;
        if (['ArrowRight', 'ArrowDown', 'PageDown', ' '].includes(e.key)) { e.preventDefault(); go(current() + 1); }
        else if (['ArrowLeft', 'ArrowUp', 'PageUp'].includes(e.key)) { e.preventDefault(); go(current() - 1); }
        else if (e.key === 'Home') { e.preventDefault(); go(0); }
        else if (e.key === 'End') { e.preventDefault(); go(slides.length - 1); }
        else if (e.key.toLowerCase() === 'n') { if (notes) notes.hidden = !notes.hidden; }
        else if (e.key.toLowerCase() === 'f') { document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen?.(); }
      });
      paint();
      // Presenter camera bubble (?cam=1) — for the live call: your face inside the page.
      if (new URLSearchParams(location.search).get('cam') === '1' && navigator.mediaDevices?.getUserMedia) {
        const cam = document.querySelector<HTMLElement>('.deck-cam'); const video = cam?.querySelector('video');
        navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: 640, height: 640 }, audio: false })
          .then((stream) => { if (cam && video) { video.srcObject = stream; cam.hidden = false; } })
          .catch((err) => console.warn('camera unavailable:', err));
      }
    }

    // ── Scroll choreography (GSAP) — everything below is scrubbed to scroll position ──
    if (!reduced) {
      // These get GSAP treatment instead of the generic fade-up reveal.
      document.querySelectorAll('.leadin h3, .breakdown > div, .persona, .sketch, .phases .card, .shot, .device').forEach((el) => el.removeAttribute('data-reveal'));

      // Hero: the scan settles and drifts up; the title slides away under it.
      gsap.fromTo('.hero-bg img', { scale: 1.12, yPercent: 0 }, { scale: 1, yPercent: -8, ease: 'none', scrollTrigger: { trigger: '.cs-hero', start: 'top top', end: 'bottom top', scrub: true } });
      gsap.to('.hero-copy', { yPercent: 22, opacity: 0.15, ease: 'none', scrollTrigger: { trigger: '.cs-hero', start: 'top top', end: 'bottom top', scrub: true } });

      // Section headings: a stroked skeleton that fills with the gradient as it enters (wipe L→R).
      document.querySelectorAll<HTMLElement>('.hollow').forEach((h) => {
        h.removeAttribute('data-reveal');
        h.dataset.text = h.textContent?.trim() ?? '';
        gsap.fromTo(h, { '--unfill': '100%' }, { '--unfill': '0%', ease: 'none', scrollTrigger: { trigger: h, start: 'top 90%', end: 'top 42%', scrub: true } });
      });

      // Candid lines: each one slides in as it crosses the lower third.
      gsap.utils.toArray<HTMLElement>('.leadin h3').forEach((h) => {
        gsap.fromTo(h, { opacity: 0, x: -28 }, { opacity: 1, x: 0, ease: 'none', scrollTrigger: { trigger: h, start: 'top 92%', end: 'top 62%', scrub: true } });
      });

      // Whiteboard sketches DRAW themselves on as you scroll: every stroke's dash-offset is
      // scrubbed from its full length to 0 (ink first, then labels and fills fade in).
      document.querySelectorAll<SVGSVGElement>('.sketch svg').forEach((svg) => {
        const strokes = Array.from(svg.querySelectorAll<SVGGeometryElement>('.ink, .ink-thin, .accent, .strike'));
        for (const el of strokes) { const L = el.getTotalLength(); el.style.strokeDasharray = `${L}`; el.style.strokeDashoffset = `${L}`; }
        const rest = svg.querySelectorAll('text, .fill-accent, .fill-easy, .fill-stretch, .fill-ache');
        gsap.set(rest, { opacity: 0 });
        gsap.timeline({ scrollTrigger: { trigger: svg, start: 'top 88%', end: 'bottom 40%', scrub: true } })
          .to(strokes, { strokeDashoffset: 0, ease: 'none', duration: 1, stagger: { each: 0.015 } }, 0)
          .to(rest, { opacity: 1, duration: 0.35, stagger: 0.015, ease: 'none' }, 0.5);
      });

      // Cards stagger up as their grid arrives.
      for (const sel of ['.breakdown', '.personas', '.phases', '.strip']) {
        const kids = document.querySelectorAll(`${sel} > *`);
        if (kids.length) gsap.from(kids, { y: 34, opacity: 0, duration: 0.8, stagger: 0.09, ease: 'power3.out', scrollTrigger: { trigger: sel, start: 'top 82%' } });
      }
      // Process photos drift a little (parallax inside their frames).
      gsap.utils.toArray<HTMLElement>('.shot img').forEach((img) => {
        gsap.fromTo(img, { yPercent: -5 }, { yPercent: 5, ease: 'none', scrollTrigger: { trigger: img, start: 'top bottom', end: 'bottom top', scrub: true } });
      });
      // The device lands.
      gsap.from('.device', { scale: 0.88, opacity: 0, y: 40, duration: 1.1, ease: 'power3.out', scrollTrigger: { trigger: '.wheel-wrap', start: 'top 78%' } });
    }

    // Reveal-on-scroll for everything else (same pattern as the home page — visible by default).
    const els = Array.from(document.querySelectorAll('[data-reveal]'));
    if (els.length && !reduced && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('reveal-js');
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
      els.forEach((el) => io.observe(el));
      setTimeout(() => els.forEach((el) => el.classList.add('in')), 2500);
    }
    document.querySelectorAll<HTMLElement>('.glint, .hollow').forEach((el) => { el.dataset.text = el.textContent?.trim() ?? ''; });

    // The live radial thumb-wheel — the 2013 idea in 2026 componentry: drag/spin with pointer
    // or thumb, momentum + friction under the pad, oversized invisible hitbox, keyboard-nudgeable.
    const wheel = document.querySelector<HTMLElement>('.wheel');
    if (wheel) {
      const rotor = wheel.querySelector<SVGGElement>('.rotor')!;
      const ticks = wheel.querySelector('.ticks')!;
      const readout = document.querySelector<HTMLElement>('.readout b');
      let s = '';
      for (let i = 0; i < 36; i++) { const a = i * 10 * Math.PI / 180, r1 = i % 9 === 0 ? 62 : 70, r2 = 84;
        s += `<line class="tick${i % 9 === 0 ? ' major' : ''}" x1="${100 + Math.cos(a) * r1}" y1="${100 + Math.sin(a) * r1}" x2="${100 + Math.cos(a) * r2}" y2="${100 + Math.sin(a) * r2}"/>`; }
      ticks.innerHTML = s;

      let angle = 0, vel = 0, dragging = false, lastA = 0, lastT = 0, raf = 0;
      const MIN = 2, MAX = 30, START = 12.4;
      const center = () => { const r = wheel.getBoundingClientRect(); return { x: r.left + r.width / 2, y: r.top + r.height / 2 }; };
      const angleAt = (e: PointerEvent) => { const c = center(); return Math.atan2(e.clientY - c.y, e.clientX - c.x) * 180 / Math.PI; };
      const depth = () => Math.min(MAX, Math.max(MIN, START + angle / 36)); // 36° per cm
      const paint = () => { rotor.style.transform = `rotate(${angle}deg)`; const d = depth(); if (readout) readout.textContent = d.toFixed(1) + ' cm'; wheel.setAttribute('aria-valuenow', d.toFixed(1)); };
      const tick = () => { if (dragging || Math.abs(vel) < 0.05) { vel = 0; raf = 0; return; } angle += vel; vel *= 0.94; paint(); raf = requestAnimationFrame(tick); };
      wheel.addEventListener('pointerdown', (e) => { dragging = true; vel = 0; cancelAnimationFrame(raf); raf = 0; lastA = angleAt(e); lastT = performance.now(); wheel.setPointerCapture(e.pointerId); });
