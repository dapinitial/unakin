    /* ---------- the beat engine: one beat owns the frame at a time ----------
       No native scrolling. Every top-level section is absolutely positioned over the viewport;
       the active one is visible, the rest are parked. Wheel / keys / swipe / dots move between
       beats; each beat's animations play to completion on enter (never tied to scroll). */
    /* Scroll proxy: the document is 3 screens tall behind a hidden scrollbar and parked at the
       middle. Anything that scrolls the window (a hand-tracking extension's fist-scroll, voice
       "down"/"up", a screen reader) moves the beat and re-parks — so assistive input drives the
       deck without knowing about it. Real wheel input is handled directly. */
    :global(html.beats) { height: 100%; overflow-y: scroll; overscroll-behavior: none; scrollbar-width: none; scroll-behavior: auto !important; /* proxy needs instant jumps, not smooth trickles */ }
    :global(html.beats::-webkit-scrollbar) { display: none; }
    :global(html.beats body) { height: 300vh; overflow: visible; }
    :global(html:fullscreen .nav) { display: none; }
    :global(html.beats .foot) { display: none; }
    .cs { position: fixed; inset: 0; z-index: 3; overflow: hidden; }
    .cs > section {
      position: absolute; inset: 0; padding: clamp(5rem, 12vh, 7rem) clamp(1.25rem, 5vw, 4rem) clamp(2.5rem, 7vh, 4rem);
      display: grid; grid-template-columns: minmax(0, 1fr); align-content: center; row-gap: 0.9rem;
      opacity: 0; visibility: hidden; pointer-events: none; will-change: opacity, transform;
    }
    .cs > section.active { opacity: 1; visibility: visible; pointer-events: auto; }
    /* the sections still carry .container/.narrow from the scrolling layout — in beat mode the
