    /* ── Deck mode (?deck=1): every section is a fullscreen slide ── */
    .threads { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0.9rem; margin: 1.6rem 0 1.4rem; }
    .threads .stat { position: relative; display: grid; gap: 0.25rem; padding: 1rem 1.1rem; border-radius: 14px; background: rgba(13,18,32,.62); border: 1px solid var(--border); backdrop-filter: blur(10px); box-shadow: 0 10px 40px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.06); }
    .threads .stat b { font-family: var(--display); font-weight: 400; font-size: 1.5rem; letter-spacing: 0.05em; color: var(--accent); line-height: 1; }
    .threads .stat span { font-family: var(--mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); line-height: 1.5; }
    .deck-only { display: none; }
    .cs.deck .deck-only { display: block; }
    .cs.deck > section { min-height: 100vh; scroll-snap-align: start; display: flex; flex-direction: column; justify-content: center; padding-top: clamp(4rem, 10vh, 7rem); padding-bottom: clamp(4rem, 10vh, 7rem); }
    .cs.deck .cs-hero { margin-top: 0; }
    .cs.deck .slide-title .cs-title { font-size: clamp(3rem, 9vw, 7.5rem); }
    .cs.deck .slide-title .lede { max-width: 52ch; font-size: clamp(1.15rem, 1.9vw, 1.45rem); }
    :global(html.deck) { scroll-snap-type: y proximity; }
    :global(html.deck .nav), :global(html.deck .foot) { display: none; }
    .deck-bar { position: fixed; left: 0; right: 0; top: 0; height: 3px; z-index: 70; background: rgba(255,255,255,.08); }
    .deck-fill { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--violet), var(--accent), var(--mint)); transition: width .4s ease; }
    .deck-notes { position: fixed; left: 14px; bottom: 14px; z-index: 70; width: min(92vw, 34rem); max-height: 42vh; overflow: auto; padding: 1rem 1.2rem; border-radius: 16px; background: rgba(13,18,32,.9); border: 1px solid var(--border); backdrop-filter: blur(14px); box-shadow: 0 20px 60px rgba(0,0,0,.5); }
    .deck-notes-body { margin-top: 0.5rem; font-size: 0.95rem; line-height: 1.6; color: var(--text); white-space: pre-wrap; }
    .deck-cam { position: fixed; left: 14px; bottom: 14px; z-index: 69; width: 12rem; aspect-ratio: 1; border-radius: 50%; overflow: hidden; border: 2px solid rgba(255,255,255,.35); box-shadow: 0 20px 60px rgba(0,0,0,.5); background: #000; }
    .deck-cam video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
    .deck-cam-name { position: absolute; left: 0; right: 0; bottom: 8%; text-align: center; font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase; color: #fff; text-shadow: 0 1px 6px rgba(0,0,0,.8); }
