    .sketch .ink-thin { fill: none; stroke: var(--ink); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; opacity: 0.85; }
    .sketch .accent { fill: none; stroke: var(--accent-c); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
    .sketch .fill-accent { fill: var(--accent-c); opacity: 0.18; }
    .sketch .fill-easy { fill: #8bf0cf; opacity: 0.22; }
    .sketch .fill-stretch { fill: #f0d68b; opacity: 0.22; }
    .sketch .fill-ache { fill: #fb7185; opacity: 0.25; }
    .sketch .hand { font-family: var(--hand); fill: var(--ink); font-size: 15px; }
    .sketch .hand.big { font-size: 20px; }
    .sketch .hand.small { font-size: 12.5px; opacity: 0.8; }
    .sketch .hand.accent-txt { fill: var(--accent-c); }
