    /* edge zones: the whole left / right 9% of the frame is a prev / next button — pinch anywhere there */
    :global(.beat-zone) { position: fixed; top: 4.5rem; bottom: 0; width: 9vw; min-width: 64px; z-index: 55; border: 0; background: transparent; cursor: pointer; color: rgba(255,255,255,.0); font-size: 2.2rem; display: grid; place-items: center; transition: color .25s ease, background .25s ease; }
    :global(.beat-zone.prev) { left: 0; } .beat-zone.next { right: 0; }
