    .video-main { padding: 0.6rem; margin-top: 1.2rem; }
    .video-main video { display: block; width: 100%; border-radius: 12px; background: #000; max-height: 70vh; }
    .video-main .cap { padding: 0.7rem 0.4rem 0.3rem; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; }
