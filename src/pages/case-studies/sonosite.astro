    @media (max-width: 760px) { .wheel-wrap { grid-template-columns: 1fr; } }
    .device { position: relative; aspect-ratio: 10 / 16; background: linear-gradient(180deg, #0b0f1a, #070910); border-radius: 26px; box-shadow: 0 30px 70px rgba(0,0,0,.55), inset 0 0 0 2px rgba(188,192,255,.14); overflow: hidden; touch-action: none; user-select: none; }
    .device .scan { position: absolute; inset: 8% 6% 34%; border-radius: 12px; background: radial-gradient(ellipse at 50% 30%, #1c2440 0%, #0b1020 60%, #05070d 100%); overflow: hidden; }
    .device .scan::after { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 2px, transparent 2px 6px); mix-blend-mode: screen; }
