---
export interface Props {
  title?: string;
  description?: string;
  path?: string;
}
const {
  title = 'Unakin™ — avant-garde design & engineering studio',
  description = 'Unakin is an avant-garde design & engineering studio. We design and ship products — interfaces, systems, and immersive 3D — with the craft of a team that spent 20 years at Apple and Microsoft.',
  path = '/',
} = Astro.props;
const canonical = new URL(path, 'https://www.unakin.com').href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Unakin, LLC',
  url: 'https://www.unakin.com',
  email: 'hello@unakin.com',
  description,
  areaServed: 'Worldwide',
  knowsAbout: ['Product design', 'Software engineering', '3D / WebGL', 'Design systems', 'Brand & identity'],
  address: { '@type': 'PostalAddress', addressLocality: 'Seattle', addressRegion: 'WA', addressCountry: 'US' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#080a0f" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Unakin™" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preload" href="/fonts/neotrax-regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <gradient-blob></gradient-blob>

    <header class="nav">
      <a class="brand" href="/">unakin<span class="tm">™</span></a>
      <nav class="navlinks">
        <a href="/#work">Work</a>
        <a href="/#studio">Studio</a>
        <a class="cta" href="/#start">Start a project</a>
      </nav>
    </header>

    <slot />

    <footer class="foot">
      <div class="foot-in">
        <div class="foot-brand">
          <span class="brand sm">unakin<span class="tm">™</span></span>
          <p class="muted">Avant-garde design &amp; engineering.<br />Seattle, WA — working worldwide.</p>
        </div>
        <nav class="foot-links" aria-label="Footer">
          <a href="/#work">Work</a>
          <a href="/#studio">Studio</a>
          <a href="/#start">Start a project</a>
          <a href="https://portal.unakin.com">Client portal</a>
        </nav>
        <div class="foot-contact">
          <a class="foot-mail" href="mailto:hello@unakin.com">hello@unakin.com</a>
          <span class="muted mono-sm">© {new Date().getFullYear()} Unakin, LLC</span>
        </div>
      </div>
    </footer>

    <script>
      import '../components/gradient-blob';
      // three.js is heavy — load it only if the page mounts a glass model.
      if (document.querySelector('glass-model')) import('../components/glass-model');
    </script>

    <style is:global>
      /* Neotrax — techno display face (Befonts, commercial-use license on file). */
      /* Preloaded in <head>; block (not swap) so display headings never flash the fallback face. */
      @font-face {
        font-family: 'Neotrax';
        src: url('/fonts/neotrax-regular.otf') format('opentype');
        font-weight: 400; font-style: normal; font-display: block;
      }
      :root {
        --bg-1: rgb(8, 10, 15);
        --bg-2: rgb(0, 17, 32);
        --panel: #0d1220;
        --panel-2: #121a2c;
        --border: rgba(188, 192, 255, 0.14);
        --text: #f4f5fb;
        --muted: #9a9fc4;
        --accent: #bcc0ff;
        --violet: #6d4aff;
        --mint: #8bf0cf;
        --mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        --display: 'Neotrax', 'Fraunces', system-ui, sans-serif;
        color-scheme: dark;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { overflow-x: clip; scroll-behavior: smooth; }
      body {
        min-height: 100vh;
        background: linear-gradient(40deg, var(--bg-1), var(--bg-2));
        color: var(--text);
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; }
      [hidden] { display: none !important; }

      h1, h2, h3 { font-family: 'Fraunces', Georgia, serif; font-optical-sizing: auto; line-height: 1.08; letter-spacing: -0.02em; text-wrap: balance; }
      .eyebrow { font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.28em; font-size: 0.68rem; color: var(--accent); opacity: 0.9; }
      .grad-text {
        background: linear-gradient(162deg, #fff 0%, var(--accent) 62%, var(--violet) 100%);
        -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;
      }
      /* House display heading: Neotrax, uppercase, tight leading — the hero voice, reused at
         every size. .glint adds a pink→white→cyan light sweeping through the letterforms
         (a highlight layer over the base fill, clipped to the text; sweeps, then rests). */
      .display-h { font-family: var(--display); text-transform: uppercase; font-weight: 400; line-height: 0.86; letter-spacing: 0.07em; text-wrap: balance; }
      /* On hover: a light sweeps the letter OUTLINES first (a stroked copy of the text, masked
         by a moving band), then the same band sweeps through the FILL ~250ms behind. Quiet at rest. */
      .glint {
        --fill: linear-gradient(#f4f5fb, #f4f5fb);
        --band: linear-gradient(105deg, transparent 42%, rgba(255, 79, 216, 0.85) 47%, #fff 50%, rgba(79, 227, 255, 0.85) 53%, transparent 58%);
        position: relative; display: inline-block;
        background-image: var(--band), var(--fill);
        background-size: 260% 100%, 100% 100%; background-position: 130% 0, 0 0; background-repeat: no-repeat;
        -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;
      }
      .glint.grad-text { --fill: linear-gradient(162deg, #fff 0%, var(--accent) 62%, var(--violet) 100%); }
      .glint::before {
        content: attr(data-text); position: absolute; inset: 0; pointer-events: none;
        color: transparent; -webkit-text-fill-color: transparent; -webkit-text-stroke: 1.5px #fff;
        -webkit-mask-image: linear-gradient(105deg, transparent 40%, #000 50%, transparent 60%); mask-image: linear-gradient(105deg, transparent 40%, #000 50%, transparent 60%);
        -webkit-mask-size: 260% 100%; mask-size: 260% 100%; -webkit-mask-position: 130% 0; mask-position: 130% 0; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
        opacity: 0;
      }
      .glint:hover::before { animation: glint-stroke 0.9s ease-in-out forwards; }
      .glint:hover { animation: glint-fill 0.9s ease-in-out 0.25s forwards; }
      @keyframes glint-stroke { 0% { opacity: 1; mask-position: 130% 0; -webkit-mask-position: 130% 0; } 100% { opacity: 1; mask-position: -130% 0; -webkit-mask-position: -130% 0; } }
      @keyframes glint-fill { from { background-position: 130% 0, 0 0; } to { background-position: -130% 0, 0 0; } }
      @media (prefers-reduced-motion: reduce) { .glint:hover, .glint:hover::before { animation: none; } }
      .container { width: min(100% - 2.5rem, 1120px); margin-inline: auto; }
      .container.narrow { width: min(100% - 2.5rem, 720px); }
      .muted { color: var(--muted); }

      .btn {
        display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer; white-space: nowrap;
        background: linear-gradient(180deg, var(--accent), #9aa0ff); color: #0b0d16; font: inherit; font-weight: 600;
        border: 0; border-radius: 999px; padding: 0.8rem 1.5rem; transition: transform 0.15s ease, box-shadow 0.2s ease;
      }
      .btn:hover { transform: translateY(-1px); box-shadow: 0 10px 30px rgba(109, 74, 255, 0.32); }
      .ghost-btn {
        display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; white-space: nowrap;
        background: transparent; border: 1px solid var(--border); border-radius: 999px; padding: 0.7rem 1.3rem;
        color: var(--text); font: inherit; transition: border-color 0.2s ease, background 0.2s ease, transform 0.15s ease;
      }
      .ghost-btn:hover { border-color: var(--accent); background: rgba(188, 192, 255, 0.08); transform: translateY(-1px); }

      /* Background islands */
      gradient-blob {
        display: block; position: fixed; inset: 0; overflow: hidden; z-index: 0;
        background: linear-gradient(40deg, var(--bg-1), var(--bg-2));
      }
      gradient-blob canvas { display: block; width: 100%; height: 100%; }
      /* Glass models fill whatever box the page gives them (canvas lives in the shadow root). */
      glass-model {
        display: block; position: relative;
        /* feather the canvas so bloom halos / flying shards never meet a hard edge */
        -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 58%, transparent 100%);
        mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 58%, transparent 100%);
      }

      /* Nav + footer */
      .nav {
        position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between;
        gap: 1rem; padding: 1rem clamp(1.25rem, 4vw, 2.5rem);
        background: rgba(8, 10, 15, 0.55); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border);
      }
      .brand { font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.25rem; letter-spacing: -0.01em; }
      .brand .tm { color: var(--violet); font-size: 0.7em; vertical-align: super; }
      .brand.sm { font-size: 1rem; }
      .navlinks { display: flex; align-items: center; gap: 1.4rem; font-size: 0.9rem; }
      .navlinks a:not(.cta):hover { color: var(--accent); }
      .navlinks .cta { border: 1px solid var(--border); border-radius: 999px; padding: 0.5rem 1rem; transition: border-color 0.2s, background 0.2s; }
      .navlinks .cta:hover { border-color: var(--accent); background: rgba(188, 192, 255, 0.08); }
      @media (max-width: 560px) { .navlinks a:not(.cta) { display: none; } }

      main { position: relative; z-index: 3; }

      .foot { position: relative; z-index: 3; border-top: 1px solid var(--border); margin-top: 4rem; padding: 3rem 0 2.5rem; background: rgba(8, 10, 15, 0.6); backdrop-filter: blur(10px); }
      .foot-in {
        width: min(100% - 2.5rem, 1120px); margin-inline: auto;
        display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 2rem; align-items: start; font-size: 0.9rem;
      }
      .foot-brand p { margin-top: 0.6rem; font-size: 0.85rem; line-height: 1.5; }
      .foot-links { display: grid; gap: 0.5rem; align-content: start; }
      .foot-links a { color: var(--muted); transition: color 0.2s; width: fit-content; }
      .foot-links a:hover { color: var(--accent); }
      .foot-contact { display: grid; gap: 0.5rem; justify-items: start; }
      @media (min-width: 720px) { .foot-contact { justify-items: end; text-align: right; } }
      .foot-mail { font-family: var(--mono); font-size: 0.85rem; color: var(--accent); border-bottom: 1px solid transparent; transition: border-color 0.2s; }
      .foot-mail:hover { border-color: var(--accent); }
      .mono-sm { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.06em; }
      @media (max-width: 720px) { .foot-in { grid-template-columns: 1fr; gap: 1.6rem; } }

      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    </style>
  </body>
</html>
